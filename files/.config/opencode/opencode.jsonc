{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "websearch": "allow"
  },
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://internal.bakos.pe/litellm"
      },
      "models": {
        "deepseek-v4.1-flash:1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "high", "max"]
            }
          }
        },
        "deepseek-v4-pro:0813": {
          "name": "DeepSeek V4 Pro 0813",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "high", "max"]
            }
          }
        },
        "gemma4:31b": {
          "name": "Gemma 4 31B",
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "reasoning": {
              "supported": true,
              "effort": ["none", "high"]
            }
          }
        },
        "kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "medium", "high", "max"]
            }
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "high", "max"]
            }
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "high", "max"]
            }
          }
        },
        "mistral-large-4": {
          "name": "Mistral Large 4",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "reasoning": {
